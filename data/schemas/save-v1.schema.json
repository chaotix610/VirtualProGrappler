{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpg-engine.local/schemas/save-v1.schema.json",
  "title": "VPG local workspace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "activeSaveId",
    "settingsRevision",
    "settings",
    "legacyMigrated",
    "saves"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "activeSaveId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "settingsRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "legacyMigrated": {
      "const": true
    },
    "saves": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/save"
      }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controls",
        "audio",
        "preferences"
      ],
      "properties": {
        "controls": {
          "$ref": "https://vpg-engine.local/schemas/control-mappings.schema.json"
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "muted",
            "volume"
          ],
          "properties": {
            "muted": {
              "type": "boolean"
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "preferences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "remindOnExit"
          ],
          "properties": {
            "remindOnExit": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "previewImage",
        "stage",
        "floor",
        "barricade",
        "outer",
        "arenaTextures",
        "ringTextures"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        },
        "displayName": {
          "type": "string",
          "maxLength": 160
        },
        "previewImage": {
          "type": "string",
          "maxLength": 1024
        },
        "stage": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 80
        },
        "floor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "barricade": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "outer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "arenaTextures": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "ringTextures": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "editingId",
        "draft"
      ],
      "properties": {
        "id": {
          "const": "editor"
        },
        "editingId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "draft": {
          "$ref": "#/$defs/draft"
        }
      }
    },
    "save": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "createdAt",
        "updatedAt",
        "revision",
        "arenas",
        "drafts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "arenas": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "https://vpg-engine.local/schemas/arenas.schema.json"
          }
        },
        "drafts": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/recovery"
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "createdAt",
            "exportedAt"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "exportedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "lastBackup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attemptedAt",
            "revision",
            "settingsRevision"
          ],
          "properties": {
            "attemptedAt": {
              "type": "string",
              "format": "date-time"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "settingsRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    }
  }
}
