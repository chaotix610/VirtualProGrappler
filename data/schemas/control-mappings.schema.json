{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpg-engine.local/schemas/control-mappings.schema.json",
  "title": "VPG Engine \u2014 Control Mappings",
  "description": "Controller profile mapping all virtual pad controls to keyboard, mouse, or gamepad inputs. Cross-control binding conflicts require separate validation.",
  "type": "object",
  "required": [
    "version",
    "profile",
    "bindings"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional schema location for editor validation."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "object",
      "required": [
        "dpadUp",
        "dpadDown",
        "dpadLeft",
        "dpadRight",
        "controlStickUp",
        "controlStickDown",
        "controlStickLeft",
        "controlStickRight",
        "a",
        "b",
        "z",
        "l",
        "r",
        "start",
        "cUp",
        "cDown",
        "cLeft",
        "cRight"
      ],
      "additionalProperties": false,
      "properties": {
        "dpadUp": {
          "$ref": "#/$defs/bindings"
        },
        "dpadDown": {
          "$ref": "#/$defs/bindings"
        },
        "dpadLeft": {
          "$ref": "#/$defs/bindings"
        },
        "dpadRight": {
          "$ref": "#/$defs/bindings"
        },
        "controlStickUp": {
          "$ref": "#/$defs/bindings"
        },
        "controlStickDown": {
          "$ref": "#/$defs/bindings"
        },
        "controlStickLeft": {
          "$ref": "#/$defs/bindings"
        },
        "controlStickRight": {
          "$ref": "#/$defs/bindings"
        },
        "a": {
          "$ref": "#/$defs/bindings"
        },
        "b": {
          "$ref": "#/$defs/bindings"
        },
        "z": {
          "$ref": "#/$defs/bindings"
        },
        "l": {
          "$ref": "#/$defs/bindings"
        },
        "r": {
          "$ref": "#/$defs/bindings"
        },
        "start": {
          "$ref": "#/$defs/bindings"
        },
        "cUp": {
          "$ref": "#/$defs/bindings"
        },
        "cDown": {
          "$ref": "#/$defs/bindings"
        },
        "cLeft": {
          "$ref": "#/$defs/bindings"
        },
        "cRight": {
          "$ref": "#/$defs/bindings"
        }
      }
    }
  },
  "$defs": {
    "bindings": {
      "description": "An empty array leaves the control unbound. Multiple distinct inputs may map to one control.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "input": {
      "description": "KeyboardEvent.code (such as KeyW or ArrowUp), mouse button index, gamepad button index, or signed gamepad axis. Keyboard codes are not exhaustively enumerated.",
      "type": "string",
      "pattern": "^([A-Za-z][A-Za-z0-9]*|mouse:[0-9]+|gamepad:button:[0-9]+|gamepad:axis:[0-9]+:(positive|negative))$"
    }
  }
}
