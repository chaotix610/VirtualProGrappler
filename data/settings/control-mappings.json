{
  "$schema": "../schemas/control-mappings.schema.json",
  "version": "1.0.0",
  "profile": "default",
  "bindings": {
    "dpadUp": ["ArrowUp", "gamepad:button:12"],
    "dpadDown": ["ArrowDown", "gamepad:button:13"],
    "dpadLeft": ["ArrowLeft", "gamepad:button:14"],
    "dpadRight": ["ArrowRight", "gamepad:button:15"],
    "controlStickUp": ["KeyW", "gamepad:axis:1:negative"],
    "controlStickDown": ["KeyS", "gamepad:axis:1:positive"],
    "controlStickLeft": ["KeyA", "gamepad:axis:0:negative"],
    "controlStickRight": ["KeyD", "gamepad:axis:0:positive"],
    "a": ["Enter", "gamepad:button:0"],
    "b": ["Escape", "gamepad:button:2"],
    "z": ["KeyZ", "gamepad:button:6"],
    "l": ["KeyQ", "gamepad:button:4"],
    "r": ["KeyE", "gamepad:button:5"],
    "start": ["Space", "gamepad:button:9"],
    "cUp": ["KeyI", "gamepad:axis:3:negative"],
    "cDown": ["KeyK", "gamepad:axis:3:positive"],
    "cLeft": ["KeyJ", "gamepad:axis:2:negative"],
    "cRight": ["KeyL", "gamepad:axis:2:positive"]
  }
}
