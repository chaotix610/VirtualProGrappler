{
  "name": "virtual-pro-grappler",
  "version": "0.2.0",
  "scripts": {
    "serve": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "node tools/validate-data.mjs",
    "assets:promote": "node tools/promote-assets.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.20.0",
    "@babylonjs/loaders": "^9.20.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "ajv": "^8.20.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  },
  "type": "module",
  "description": "Virtual Pro Grappler - an AKI-style pro wrestling engine built on Babylon.js",
  "private": true
}
