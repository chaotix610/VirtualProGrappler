{
  "name": "virtual-pro-grappler",
  "version": "0.2.0",
  "scripts": {
    "serve": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "node tools/validate-data.mjs",
    "assets:promote": "node tools/promote-assets.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.20.0",
    "@babylonjs/loaders": "^9.20.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^4.18.0",
    "@typescript-eslint/parser": "^4.18.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.0.0",
    "@vue/eslint-config-typescript": "^7.0.0",
    "ajv": "^8.20.0",
    "eslint": "^6.7.2",
    "eslint-plugin-vue": "^7.0.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "type": "module",
  "description": "Virtual Pro Grappler - an AKI-style pro wrestling engine built on Babylon.js",
  "private": true
}
